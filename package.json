{
  "name": "code-editor",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs && node scripts/fetch-clang.mjs && node scripts/fetch-flowchart-grammars.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs && node scripts/fetch-clang.mjs && node scripts/fetch-flowchart-grammars.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:pages": "wrangler pages dev dist --ip 127.0.0.1 --port 8788 --compatibility-date 2026-10-01",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run --dir src && vitest run --dir server",
    "e2e": "playwright test",
    "e2e:speed": "playwright test --project=speed --no-deps",
    "gen:completions:c": "node scripts/gen-c-completions.mjs",
    "gen:completions:python": "node scripts/gen-python-completions.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/cpp": "1.1.6",
    "@lezer/highlight": "1.2.5",
    "idb": "8.0.3",
    "pyodide": "314.0.7",
    "three": "0.186.1",
    "uqr": "0.1.3",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "fake-indexeddb": "6.2.5",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1",
    "wrangler": "4.149.0"
  }
}
